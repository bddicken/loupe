{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.dmg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/bddicken/loupe/releases/download/v1.0.2/Loupe-1.0.2.dmg",
      "permanent": false
    }
  ]
}
