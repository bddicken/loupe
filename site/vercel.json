{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.dmg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "loupe-liart.vercel.app" }],
      "destination": "https://loupe.pics/:path*",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "{{DOWNLOAD_PATH}}",
      "permanent": false
    }
  ]
}
